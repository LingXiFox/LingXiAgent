{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/lingxiagent/providers.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "enum": ["https://schemas.example.invalid/lingxiagent/providers.schema.json"]
    },
    "version": { "type": "integer", "enum": [1], "minimum": 1 },
    "model": { "type": ["string", "null"], "minLength": 1 },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "adapter": { "type": "string", "enum": ["openai-compatible", "openai-responses", "anthropic-messages"] },
          "options": {
            "type": "object",
            "properties": {
              "baseURL": { "type": "string", "minLength": 1 },
              "apiKey": { "type": ["string", "null"], "minLength": 1, "pattern": "^\\{(env|vault):[^{}]+\\}$" },
              "apiKeyHeader": { "type": ["string", "null"], "minLength": 1 },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } }
            },
            "required": ["baseURL"],
            "additionalProperties": false
          },
          "models": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "reasoning": { "type": "boolean" },
                "limit": {
                  "type": "object",
                  "properties": {
                    "context": { "type": "integer", "minimum": 1 },
                    "output": { "type": "integer", "minimum": 1 }
                  },
                  "required": ["context", "output"],
                  "additionalProperties": false
                },
                "toolCalling": { "type": "boolean" },
                "parallelToolCalling": { "type": "boolean" },
                "vision": { "type": "boolean" },
                "structuredOutput": { "type": "boolean" }
              },
              "required": ["name", "limit"],
              "additionalProperties": false
            }
          }
        },
        "required": ["name", "adapter", "options", "models"],
        "additionalProperties": false
      }
    }
  },
  "required": ["$schema", "version", "providers"],
  "additionalProperties": false
}
