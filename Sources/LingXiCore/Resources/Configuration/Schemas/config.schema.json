{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/lingxiagent/config.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://schemas.example.invalid/lingxiagent/config.schema.json"
      ]
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "minimum": 1
    },
    "core": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string"
        },
        "logLevel": {
          "type": "string",
          "enum": [
            "debug",
            "info",
            "warning",
            "error"
          ]
        }
      },
      "required": [
        "locale",
        "logLevel"
      ],
      "additionalProperties": false
    },
    "agent": {
      "type": "object",
      "properties": {
        "maxConcurrentSubagents": {
          "type": "integer",
          "minimum": 1
        },
        "maxSubagentDepth": {
          "type": "integer",
          "minimum": 1
        },
        "maxTotalRunsPerRootRun": {
          "type": "integer",
          "minimum": 1
        },
        "permissionPolicy": {
          "type": "string",
          "enum": ["ask", "auto"]
        },
        "executionProfile": {
          "type": "string",
          "enum": ["readOnly", "workspace", "fullAccess"]
        },
        "codeIntelligenceEnabled": {
          "type": "boolean"
        },
        "behaviorProfile": {
          "type": ["string", "null"],
          "enum": ["build", "plan", "explore", null]
        },
        "systemContext": {
          "type": ["string", "null"]
        },
        "l2MaxCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "l1ProjectMaxCharacters": {
          "type": "integer",
          "minimum": 1
        },
        "preferredActiveTokens": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "maxAgentLoopSteps": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "maxConcurrentSubagents",
        "maxSubagentDepth",
        "maxTotalRunsPerRootRun"
      ],
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "properties": {
        "interactive": {
          "type": "boolean"
        },
        "commandTimeoutSeconds": {
          "type": "number",
          "minimum": 0
        },
        "execution": {
          "type": "object",
          "properties": {
            "quickFilesystemSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "searchSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "foregroundShellSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "buildTestSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "mcpSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "providerSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "providerIdleSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "subagentSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "agentRunSeconds": { "type": "number", "exclusiveMinimum": 0 },
            "maximumSeconds": { "type": "number", "exclusiveMinimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "interactive",
        "commandTimeoutSeconds"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "addressableBudget": { "type": "integer", "minimum": 1 },
        "l1": {
          "type": "object",
          "properties": {
            "target": { "type": "integer", "minimum": 1 },
            "softLimit": { "type": "integer", "minimum": 1 },
            "hardLimit": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "l2": {
          "type": "object",
          "properties": {
            "max": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        },
        "l3": {
          "type": "object",
          "properties": {
            "max": { "type": "integer", "minimum": 0 },
            "useRemainingBudget": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "reserve": { "type": "integer", "minimum": 0 },
        "economicThreshold": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "version",
    "core",
    "agent",
    "runtime"
  ],
  "additionalProperties": false
}
