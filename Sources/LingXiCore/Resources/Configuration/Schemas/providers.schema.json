{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/lingxiagent/providers.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "enum": [
        "https://schemas.example.invalid/lingxiagent/providers.schema.json"
      ]
    },
    "version": {
      "type": "integer",
      "enum": [
        1
      ],
      "minimum": 1
    },
    "customProviders": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "baseURL": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "displayName",
          "baseURL"
        ],
        "additionalProperties": false
      }
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "providerID": { "type": "string" },
          "displayName": { "type": "string" },
          "enabled": { "type": "boolean" },
          "authentication": {
            "type": "string",
            "enum": ["none", "bearer", "header"]
          },
          "headerName": { "type": "string" },
          "credential": { "type": "string" },
          "endpointOverride": { "type": "string" },
          "configOverrides": {
            "type": "object"
          },
          "createdAt": { "type": "number" },
          "updatedAt": { "type": "number" }
        },
        "required": [
          "id", "providerID", "displayName", "enabled", "authentication",
          "configOverrides", "createdAt", "updatedAt"
        ],
        "additionalProperties": false
      }
    },
    "modelProfiles": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "providerID": { "type": "string" },
          "modelID": { "type": "string" },
          "displayName": { "type": "string" },
          "wireProtocol": {
            "type": "string",
            "enum": ["chatCompletions", "responses", "anthropicMessages"]
          },
          "contextWindow": { "type": "integer", "minimum": 1 },
          "maxOutputTokens": { "type": "integer", "minimum": 1 },
          "capabilities": {
            "type": "object",
            "properties": {
              "toolCalling": { "type": "boolean" },
              "parallelToolCalling": { "type": "boolean" },
              "reasoning": { "type": "boolean" },
              "vision": { "type": "boolean" },
              "structuredOutput": { "type": "boolean" }
            },
            "required": ["toolCalling", "parallelToolCalling", "reasoning", "vision", "structuredOutput"],
            "additionalProperties": false
          },
          "remoteStateEnabled": { "type": "boolean" }
        },
        "required": [
          "id", "providerID", "modelID", "displayName", "wireProtocol",
          "contextWindow", "capabilities", "remoteStateEnabled"
        ],
        "additionalProperties": false
      }
    },
    "defaultSelection": {
      "type": "object",
      "properties": {
        "accountID": { "type": "string" },
        "profileID": { "type": "string" }
      },
      "required": ["accountID", "profileID"],
      "additionalProperties": false
    }
  },
  "required": [
    "$schema",
    "version",
    "customProviders",
    "accounts",
    "modelProfiles"
  ],
  "additionalProperties": false
}
