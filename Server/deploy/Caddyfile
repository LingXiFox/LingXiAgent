{
	# The admin API stays reachable, but only over a loopback Unix socket owned
	# by the caddy user with mode 0600 — no TCP port, no network exposure. This
	# is what lets configuration changes be applied with `systemctl reload caddy`
	# (a hot reload with no dropped connections) instead of a restart.
	#
	# `admin off` was the previous setting and made hot reload impossible: every
	# Caddyfile change required restarting the process, briefly interrupting
	# every site it serves.
	admin unix//run/caddy/admin.sock|0600

	debug
	email lingxifox@gmail.com
}

http://lingxifox.cn, http://www.lingxifox.cn {
	redir https://www.lingxifox.cn{uri} permanent
}

www.lingxifox.cn {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/certs/lingxi-esa-origin-ca.pem
			}
		}
	}

	encode zstd gzip

	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		-Server
	}

	log {
		output file /var/log/caddy/lingxifox-access.log
		format console
	}
}

lingxifox.cn {
	redir https://www.lingxifox.cn{uri} permanent
}

http://lingxiagent.lingxifox.cn {
	# Static host: the JSON Schema documents other layers name as their $id,
	# plus the legacy /models/* files kept readable for older checkouts.
	# Public model data lives at models.lingxifox.cn/models.json — one source.
	handle {
		root * /var/www/lingxiagent

		@models {
			path_regexp model ^/models/([a-zA-Z0-9_\-]+)/?$
		}
		rewrite @models /models/{re.model.1}.json

		encode zstd gzip
		file_server
	}

	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, If-None-Match, If-Modified-Since"
		-Server
	}

	header Cache-Control "public, max-age=3600"
}

lingxiagent.lingxifox.cn {
	tls {
		ca https://acme.zerossl.com/v2/DV90
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/certs/lingxi-esa-origin-ca.pem
			}
		}
	}

	handle {
		root * /var/www/lingxiagent

		@models {
			path_regexp model ^/models/([a-zA-Z0-9_\-]+)/?$
		}
		rewrite @models /models/{re.model.1}.json

		encode zstd gzip
		file_server
	}

	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, If-None-Match, If-Modified-Since"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		-Server
	}

	# Everything this host serves is static; a plain long TTL is enough.
	header Cache-Control "public, max-age=3600"

	log {
		output file /var/log/caddy/lingxiagent-access.log
		format console
	}
}

http://models.lingxifox.cn {
	handle {
		root * /var/www/models.lingxifox.cn

		# Same rule as the agent site: /index.html is an alias, not a second page.
		@index_html {
			path /index.html
		}
		redir @index_html / 301

		encode zstd gzip
		file_server
	}

	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, If-None-Match, If-Modified-Since"
		-Server
	}

	@html {
		path / /index.html
	}
	header @html Cache-Control "public, max-age=60, must-revalidate"
}

models.lingxifox.cn {
	tls {
		ca https://acme.zerossl.com/v2/DV90
		client_auth {
			mode require_and_verify
			trust_pool file {
				pem_file /etc/caddy/certs/lingxi-esa-origin-ca.pem
			}
		}
	}

	handle {
		root * /var/www/models.lingxifox.cn

		# Same rule as the agent site: /index.html is an alias, not a second page.
		@index_html {
			path /index.html
		}
		redir @index_html / 301

		encode zstd gzip
		file_server
	}

	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, If-None-Match, If-Modified-Since"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		-Server
	}

	@html {
		path / /index.html
	}
	header @html Cache-Control "public, max-age=60, must-revalidate"
	# The one published model document. Revalidated by ETag, so a long TTL is
	# cheap and a stale copy is still usable when the origin is busy.
	header /models.json Cache-Control "public, max-age=1800, stale-while-revalidate=86400"
	# The publication marker states which revision is live; a deploy check reads it
	# against the repository artifact, so it must not be cached long.
	header /publication.json Cache-Control "public, max-age=60, must-revalidate"

	log {
		output file /var/log/caddy/models-access.log
		format console
	}
}

http://agent.lingxifox.cn {
	handle {
		root * /var/www/agent.lingxifox.cn

		# One document, one cache key. Clean paths are aliases that redirect to the
		# canonical .html form; /index.html folds into /. A rewrite would keep two
		# URLs serving identical bytes, and each is a separate ESA cache entry that
		# has to be purged by hand — which is exactly how a stale copy survives.
		@docs_alias {
			path /docs /docs/
		}
		redir @docs_alias /docs.html 301

		@sdk_alias {
			path /sdk /sdk/
		}
		redir @sdk_alias /sdk.html 301

		@index_html {
			path /index.html
		}
		redir @index_html / 301

		encode zstd gzip
		file_server
	}

	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
		Access-Control-Allow-Headers "Content-Type, Authorization, If-None-Match, If-Modified-Since"
		-Server
	}

	@html {
		path / /index.html /docs /docs/ /docs.html
	}
	header @html Cache-Control "public, max-age=60, must-revalidate"
	header /install Content-Type "text/plain; charset=utf-8"
	header /install.sh Content-Type "text/plain; charset=utf-8"
	header /install.ps1 Content-Type "text/plain; charset=utf-8"
	header /install Cache-Control "public, max-age=60, must-revalidate"
	header /install.sh Cache-Control "public, max-age=60, must-revalidate"
	header /install.ps1 Cache-Control "public, max-age=60, must-revalidate"
}

