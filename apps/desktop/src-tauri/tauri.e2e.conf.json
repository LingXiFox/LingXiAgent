{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeBuildCommand": "pnpm build:e2e"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "e2e",
          "description": "Automation-only capability for the WebDriver bridge",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "wdio:default",
            "wdio-webdriver:default"
          ]
        }
      ]
    }
  }
}
