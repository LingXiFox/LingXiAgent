{
  "$schema": "https://schemas.example.invalid/lingxiagent/config.schema.json",
  "agent": {
    "executionProfile": "workspace",
    "l1ProjectMaxCharacters": 32768,
    "l2MaxCharacters": 262144,
    "maxConcurrentSubagents": 4,
    "maxSubagentDepth": 3,
    "maxTotalRunsPerRootRun": 32,
    "permissionPolicy": "ask",
    "preferredActiveTokens": null,
    "systemContext": null
  },
  "core": {
    "locale": "system",
    "logLevel": "info"
  },
  "runtime": {
    "commandTimeoutSeconds": 60,
    "execution": {
      "agentRunSeconds": 1800,
      "buildTestSeconds": 300,
      "foregroundShellSeconds": 60,
      "maximumSeconds": 3600,
      "mcpSeconds": 60,
      "providerIdleSeconds": 45,
      "providerSeconds": 120,
      "quickFilesystemSeconds": 10,
      "searchSeconds": 30,
      "subagentSeconds": 600
    },
    "interactive": false
  },
  "version": 1
}
